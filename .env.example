# Nextcloud WebDAV
NEXTCLOUD_WEBDAV_URL=https://nextcloud.local/remote.php/dav/files/<username>
NEXTCLOUD_USER=<username>
# Nextcloud app password (Settings -> Security -> Devices & sessions -> create new app password).
# Never use the account's real login password here.
NEXTCLOUD_APP_PASSWORD=<app-password>

# Local read-only bind mount of the Nextcloud data directory for the watched user,
# used only for fast local reads of incoming scans. All writes go through WebDAV.
# Recommended: keep Scan Eingang INSIDE Dokumente/, so it's one coherent tree in
# Nextcloud. DEPOT structurally excludes SCAN_EINGANG_WEBDAV_PATH (and everything
# under it) from the classifier's filing candidates regardless of where it lives,
# so nesting it here is safe - it will never be offered/re-filed into itself.
SCAN_EINGANG_LOCAL_PATH=/nextcloud-data/Dokumente/Scan Eingang
# Path of the same folder relative to the WebDAV root above.
SCAN_EINGANG_WEBDAV_PATH=Dokumente/Scan Eingang

# Root of the existing, hand-maintained document tree (WebDAV-relative path).
DOKUMENTE_WEBDAV_ROOT=Dokumente
# Where low-confidence classifications are filed (created if missing). Stays
# under Dokumente/ deliberately - unlike ERROR_FOLDER below, Unsortiert holds
# real documents the user reviews and re-files by hand.
FALLBACK_FOLDER=Dokumente/Unsortiert
# Where files that repeatedly fail processing are quarantined. Defaults to
# "<SCAN_EINGANG_WEBDAV_PATH>/<CONFIG_SUBFOLDER>/_Fehlerhaft" if left unset -
# deliberately NOT under Dokumente/, since this is DEPOT's own internal
# quarantine bucket, not a real document the classifier should ever be able
# to (re-)offer as a filing target. Leave commented out to use that default,
# or set explicitly to override it.
# ERROR_FOLDER=

# Local LLM (Ollama) used only for classification, never for OCR.
# Runs as its own Dockge stack on the TrueNAS host (see infra/ollama/), so it's
# reached via the host's LAN address, not a docker-compose service name.
OLLAMA_HOST=http://10.69.69.230:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# Optional embedding model (same Ollama server) for the folder shortlist:
# the shortlist compares the document with folder names and the names of
# the files already filed there by WORDS; an embedding model adds meaning
# ("Curriculum Vitae" -> folder "Lebenslauf", an English manual -> "Manuals").
# Runs on the CPU, never the GPU, so it does not compete with OLLAMA_MODEL
# for VRAM (~0.1 s per text; vectors are cached under /scratch). Pull it
# once on the server, e.g. `ollama pull qwen3-embedding:0.6b` (best in the
# evaluation; bge-m3 is close). With it, a folder that is the best match both
# by words and for the embedding model counts as evidence (confidence 0.8).
# Leave empty for words only.
EMBEDDING_MODEL=

# Below this confidence, a document is filed into FALLBACK_FOLDER instead of guessing.
# The local classifier's confidence follows what backs its choice in the
# existing tree, not the model's own estimate:
#   0.9  the chosen folder already holds documents of this sender/kind
#   0.8  best match by words AND for the embedding model (EMBEDDING_MODEL)
#   0.7  a new subfolder inside such a folder
#   0.5  nothing in the tree supports the choice (a suggestion only - it is
#        written into the log line as "Vorschlag: <folder>")
# With the default 0.6 only backed decisions are filed; set 0.5 to have
# unbacked suggestions filed automatically as well.
CONFIDENCE_THRESHOLD=0.6

# Optional cloud fallback for the folder-routing decision only, used when
# "use_anthropic_classifier" is enabled in DEPOT Config.json (see below).
# title/date/correspondent extraction and the OCR text ALWAYS stay local via
# Ollama. Sent to Anthropic for this one decision: correspondent + title +
# the folder-name list (without year subfolders - the year follows from the
# date), plus - when available - the name you gave the file (not
# scanner-generated names), the PDF's metadata title, 3-6 locally generated
# general topic keywords, a locally generated two-sentence summary (no
# names/numbers; digit sequences and e-mail addresses are stripped), and per
# folder HOW MANY documents of this sender are already filed there. Never
# the document text itself, never the name of a filed document. Leave ANTHROPIC_API_KEY unset to keep everything fully local
# (the default).
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5

# Name prefix of the per-file log written into
# SCAN_EINGANG_LOCAL_PATH/CONFIG_SUBFOLDER (one file per processed document,
# named "<prefix> DD-MM-YYYY HH-MM-SS.txt"). Any input file whose name
# contains this string is ignored by the watcher (kept as a safety net; in
# practice the subfolder itself already keeps these out of the watcher's
# non-recursive scan of SCAN_EINGANG_LOCAL_PATH).
LOG_FILE_PREFIX=DEPOT Dateilog

# User-editable file in SCAN_EINGANG_LOCAL_PATH/CONFIG_SUBFOLDER, e.g.:
#   {
#     "excluded_folders": ["Dokumente/Games"],
#     "file_into_dokumente": true,
#     "save_processed_copy": false,
#     "use_anthropic_classifier": false
#   }
# - "excluded_folders": never offered to the classifier as a filing target,
#   even though they still exist normally in Nextcloud.
# - "file_into_dokumente" (default true): if false, the folder walk is
#   skipped entirely (title/date/correspondent are still extracted for the
#   filename) and nothing is written under DOKUMENTE_WEBDAV_ROOT at all.
# - "save_processed_copy" (default false): if true, an extra renamed+OCR'd
#   copy of every processed document is also saved flat into
#   SCAN_EINGANG_WEBDAV_PATH/CONFIG_SUBFOLDER/PROCESSED_SUBFOLDER
#   (independent of file_into_dokumente - useful as a flat "everything DEPOT
#   has touched" archive, or as the only destination when filing is off).
# - "use_anthropic_classifier" (default false): if true, the folder-routing
#   decision (which existing/new folder a document goes into) is delegated
#   to Anthropic instead of the local Ollama model - see ANTHROPIC_API_KEY
#   above for exactly what data that sends. If ANTHROPIC_API_KEY isn't set,
#   or the call fails for any reason, the document is filed into
#   FALLBACK_FOLDER instead (title/date/correspondent, already extracted
#   locally, are not lost) - it never falls back to the local folder walk
#   or blocks/retries the pipeline.
# Deliberately read fresh from this file on every processed document (not
# just at container startup) so toggling a switch here takes effect on the
# very next scan. If both filing switches would end up false, file_into_dokumente
# wins instead (with a warning in the container logs) - DEPOT would
# otherwise have nowhere to put a processed document before deleting the
# source scan. Missing file or malformed content just means "use the
# defaults above".
# - "ask_cloud_when_unsure" (default false, only relevant while
#   "use_anthropic_classifier" is false): decide locally, and only for a
#   document the local path would send to FALLBACK_FOLDER ask Anthropic as
#   well. Its answer is filed if it is at least CLOUD_MIN_CONFIDENCE sure
#   (log tag CLOUD-ENTSCHEIDUNG); otherwise the document still goes to
#   FALLBACK_FOLDER, with the cloud's folder as the suggestion.
CONFIG_FILE_NAME=DEPOT Config.json
# See "ask_cloud_when_unsure" above. Measured: 0.9 files few wrong documents,
# 0.8 files more of both right and wrong ones.
CLOUD_MIN_CONFIDENCE=0.9

# Subfolder inside SCAN_EINGANG_LOCAL_PATH that holds DEPOT Config.json and
# all per-file logs, keeping them out of the way of the actual scans.
CONFIG_SUBFOLDER=Depot Config

# Subfolder (nested under CONFIG_SUBFOLDER) used for "save_processed_copy"
# above.
PROCESSED_SUBFOLDER=Processed

OCR_LANGUAGE=deu

# The existing folder tree under DOKUMENTE_WEBDAV_ROOT is read from the local
# read-only mount when the mount covers it (SCAN_EINGANG_LOCAL_PATH ends with
# SCAN_EINGANG_WEBDAV_PATH, as in the values above) - milliseconds instead of
# one WebDAV request per folder. Set to false if parts of the tree are not on
# that mount (external storages, shares received from other users); the
# listing then goes through WebDAV as before.
USE_LOCAL_FOLDER_LISTING=true

# Processing runs in two stages: OCR (CPU) and classification + upload
# (GPU, always exactly one thread so the model keeps one document's context
# at a time). While one document is being classified, the next one is
# already being recognized. This is the number of OCR threads; keep at 1 on
# modest hardware - ocrmypdf already uses several cores for one document.
MAX_CONCURRENT_JOBS=1

# How often (seconds) the inbox is re-scanned for files still lying there:
# missed filesystem events, or files whose processing was given up after
# repeated transient failures (Ollama/Nextcloud unreachable). Only files
# unchanged for at least a minute are picked up. 0 disables the sweep.
SWEEP_INTERVAL_SECONDS=600

# Local scratch volume for the sqlite failure-tracking DB.
STATE_DB_PATH=/scratch/depot-state.sqlite3
# OCR results wait here until their scan is filed, so a retry or a restart
# in the middle of a batch never runs OCR twice for the same file. Entries
# are removed once the scan is filed, stale ones after a week. Default:
# "ocr-cache" next to STATE_DB_PATH.
# OCR_CACHE_DIR=/scratch/ocr-cache

TZ=Europe/Berlin
