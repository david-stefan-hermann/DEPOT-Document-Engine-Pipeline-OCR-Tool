# Nextcloud WebDAV
NEXTCLOUD_WEBDAV_URL=https://nextcloud.local/remote.php/dav/files/<username>
NEXTCLOUD_USER=<username>
# Nextcloud app password (Settings -> Security -> Devices & sessions -> create new app password).
# Never use the account's real login password here.
NEXTCLOUD_APP_PASSWORD=<app-password>

# Local read-only bind mount of the Nextcloud data directory for the watched user,
# used only for fast local reads of incoming scans. All writes go through WebDAV.
SCAN_EINGANG_LOCAL_PATH=/nextcloud-data/Scan-Eingang
# Path of the same folder relative to the WebDAV root above.
SCAN_EINGANG_WEBDAV_PATH=Scan-Eingang

# Root of the existing, hand-maintained document tree (WebDAV-relative path).
DOKUMENTE_WEBDAV_ROOT=Dokumente
# Where low-confidence classifications are filed (created if missing).
FALLBACK_FOLDER=Dokumente/Unsortiert
# Where files that repeatedly fail processing are quarantined.
ERROR_FOLDER=Dokumente/_Fehlerhaft

# Local LLM (Ollama) used only for classification, never for OCR.
# Runs as its own Dockge stack on the TrueNAS host (see infra/ollama/), so it's
# reached via the host's LAN address, not a docker-compose service name.
OLLAMA_HOST=http://10.69.69.230:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# Below this confidence, a document is filed into FALLBACK_FOLDER instead of guessing.
CONFIDENCE_THRESHOLD=0.6

# Name prefix of the per-file log written into
# SCAN_EINGANG_LOCAL_PATH/CONFIG_SUBFOLDER (one file per processed document,
# named "<prefix> DD-MM-YYYY HH-MM-SS.txt"). Any input file whose name
# contains this string is ignored by the watcher (kept as a safety net; in
# practice the subfolder itself already keeps these out of the watcher's
# non-recursive scan of SCAN_EINGANG_LOCAL_PATH).
LOG_FILE_PREFIX=DEPOT Dateilog

# User-editable file in SCAN_EINGANG_LOCAL_PATH/CONFIG_SUBFOLDER, e.g.:
#   { "excluded_folders": ["Dokumente/Games"] }
# Folders listed here (and everything nested under them) are never offered to
# the classifier as a filing target, even though they still exist normally in
# Nextcloud. Missing or malformed file just means "no exclusions".
CONFIG_FILE_NAME=DEPOT Config.json

# Subfolder inside SCAN_EINGANG_LOCAL_PATH that holds DEPOT Config.json and
# all per-file logs, keeping them out of the way of the actual scans.
CONFIG_SUBFOLDER=Config

OCR_LANGUAGE=deu

# Number of files processed concurrently. Keep at 1 on modest hardware (shared
# CPU for Tesseract and GPU for Ollama).
MAX_CONCURRENT_JOBS=1

# Local scratch volume for the sqlite failure-tracking DB.
STATE_DB_PATH=/scratch/depot-state.sqlite3

TZ=Europe/Berlin
